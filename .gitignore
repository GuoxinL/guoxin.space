# macOS
.DS_Store

# JetBrains IDE
.idea/

# 临时验证脚本
.tmp-*.js

# 依赖（若本地引入）
node_modules/

# 环境变量（勿提交任何密钥）
.env
.env.local

# 生成物（test-worker.mjs 运行时自动 cp worker.js 生成）
worker.test.mjs

# 本地工具数据（WorkBuddy 工作日志/产物，不入库）
.workbuddy/

# running 数据仓库（本地开发用普通 clone 管理，不再作为 submodule 发布到 Pages）
running/

# running-private 私有仓库（本地开发 clone，独立仓库）
running-private/
