{
  "name": "guoxin-space-qwik",
  "version": "2.0.0",
  "private": true,
  "description": "Personal homepage with AI-friendly design (Qwik + pnpm)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "vite build && vite build --ssr src/entry.ssr.tsx",
    "build.client": "vite build",
    "build.server": "vite build --ssr src/entry.ssr.tsx",
    "preview": "vite preview --open",
    "test": "vitest run",
    "test.watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint app/src --ext .ts,.tsx",
    "fmt": "prettier --write app/src"
  },
  "dependencies": {
    "marked": "^9.1.0"
  },
  "devDependencies": {
    "@builder.io/qwik": "~1.9.0",
    "@builder.io/qwik-city": "~1.9.0",
    "@tailwindcss/typography": "^0.5.10",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-qwik": "~1.9.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^1.6.0"
  }
}
